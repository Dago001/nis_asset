# ==============================================================================
# NIS ASSET MANAGEMENT SYSTEM (NIS-AMS) — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Configuration
APP_NAME="NIS Asset Management System"
APP_ENV=production
APP_URL=https://ams.immigration.gov.ng
APP_TIMEZONE=Africa/Lagos
FORCE_HTTPS=true
TRUST_PROXY=true

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nis_ams
DB_USER=your_db_username
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Session & Cookie Security
SESSION_NAME=NIS_AMS_SESSION
SESSION_LIFETIME=1800
SESSION_SECURE=true

# Encryption Key (Generate with: php -r "echo bin2hex(random_bytes(32));")
ENCRYPTION_KEY=your_64_character_hex_encryption_key
